{
  "name": "@marcrock22/eslintcf",
  "version": "0.0.2",
  "description": "MARCROCK22's ESLint configuration for TypeScript: ESLint, typescript-eslint (type-checked), @stylistic, perfectionist and unicorn, plus a few rules of its own.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "typescript",
    "typescript-eslint"
  ],
  "author": "MARCROCK22",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MARCROCK22/eslintcf.git"
  },
  "homepage": "https://github.com/MARCROCK22/eslintcf#readme",
  "bugs": {
    "url": "https://github.com/MARCROCK22/eslintcf/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@typescript-eslint/utils": "^8.72.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@typescript-eslint/rule-tester": "^8.72.2",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.4.1",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "packageManager": "bun@1.4.0"
}
